[Unit]
Description=Bounded read-only NAS malware scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=four-securitycenter
Group=four-securitycenter
WorkingDirectory=/opt/four-securitycenter
ExecStart=/usr/local/bin/four-securitycenter scan
SuccessExitStatus=1
Nice=15
IOSchedulingClass=idle
CPUQuota=75%
MemoryMax=1200M
TimeoutStartSec=1000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/four-securitycenter /var/log/four-securitycenter
ReadOnlyPaths=/mnt/four-securitycenter
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0027
StandardOutput=append:/var/log/four-securitycenter/scan.log
StandardError=append:/var/log/four-securitycenter/scan.log
