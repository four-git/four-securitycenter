[Unit]
Description=Discover stable NAS scan candidates without engine scans
After=network-online.target

[Service]
Type=oneshot
User=four-securitycenter
Group=four-securitycenter
WorkingDirectory=/opt/four-securitycenter
ExecStart=/usr/local/bin/four-securitycenter discover
Nice=15
CPUQuota=25%
MemoryMax=128M
TimeoutStartSec=1000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/four-securitycenter /var/log/four-securitycenter
ReadOnlyPaths=/mnt/four-securitycenter
UMask=0027
StandardOutput=append:/var/log/four-securitycenter/discover.log
StandardError=append:/var/log/four-securitycenter/discover.log
