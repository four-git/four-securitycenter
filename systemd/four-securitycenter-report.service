[Unit]
Description=Local scanner health report
After=network-online.target

[Service]
Type=oneshot
User=four-securitycenter
Group=four-securitycenter
WorkingDirectory=/opt/four-securitycenter
ExecStart=/usr/local/bin/four-securitycenter health
ExecStart=/usr/local/bin/four-securitycenter status
Nice=15
MemoryMax=128M
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/four-securitycenter /var/log/four-securitycenter
ReadOnlyPaths=/mnt/four-securitycenter
UMask=0027
StandardOutput=append:/var/log/four-securitycenter/report.log
StandardError=append:/var/log/four-securitycenter/report.log
